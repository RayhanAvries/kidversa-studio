{
    "name": "kidversa/studio",
    "description": "Kidversa Studio - Photo Booth Application",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.10",
        "endroid/qr-code": "^6.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Kidversa\\": "src/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
