# Deny script execution in uploads directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(?:php|phtml|php3|php4|php5|php7|phps|cgi|pl|asp|aspx|shtml|sh|cgi|py|htaccess)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Prevent directory listing
Options -Indexes
