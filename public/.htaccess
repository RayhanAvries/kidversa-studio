# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
</IfModule>

# Enable mod_rewrite
RewriteEngine On

# --- Cache Control Headers (Docker Dev - Apache) ---
# Cache headers: Apache (Docker dev) handles these via .htaccess
# Production (nginx + PHP-FPM): see nginx-cache.conf

# HTML pages: always revalidate
<FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# CSS/JS: aggressive cache (invalidated via query string ?v=X.Y.Z)
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Images: moderate cache (1 day)
<FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
</FilesMatch>

# JSON files: no cache
<FilesMatch "\.json$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
</FilesMatch>
# --- End Cache Control Headers ---

# Serve favicon.png as favicon.ico
RewriteRule ^favicon\.ico$ favicon.png [L]

# Prevent directory listing
Options -Indexes

# Prevent .env access
<Files .env>
    Order allow,deny
    Deny from all
</Files>

# Prevent access to sensitive files
<FilesMatch "\.(git|env|htaccess|htpasswd)$">
    Order allow,deny
    Deny from all
</FilesMatch>
